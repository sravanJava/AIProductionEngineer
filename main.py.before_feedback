# ---------------------------------------------------------
# HARNESS: APPROVE PROPOSAL
# ---------------------------------------------------------

@app.post("/harness/proposals/{proposal_id}/approve")
def approve_harness_proposal(proposal_id: str):
    object_id = get_object_id(proposal_id)

    proposal = harness_proposals.find_one(
        {"_id": object_id}
    )

    if not proposal:
        raise HTTPException(
            status_code=404,
            detail="Harness proposal not found.",
        )

    if proposal.get("status") != "proposed":
        raise HTTPException(
            status_code=409,
            detail="Only proposed items can be approved.",
        )

    candidate = proposal.get("candidate_policy")

    if not isinstance(candidate, dict):
        raise HTTPException(
            status_code=400,
            detail="Candidate policy is missing or invalid.",
        )

    validation = validate_policy(candidate)

    if not validation["valid"]:
        raise HTTPException(
            status_code=400,
            detail={
                "message": "Candidate policy failed validation.",
                "errors": validation["errors"],
            },
        )

    result = harness_proposals.update_one(
        {
            "_id": object_id,
            "status": "proposed",
        },
        {
            "$set": {
                "status": "approved",
                "approved_at": utc_now(),
                "approval_validation": validation,
            }
        },
    )

    if result.modified_count != 1:
        raise HTTPException(
            status_code=409,
            detail="Proposal changed. Reload and try again.",
        )

    return {
        "status": "approved",
        "proposal_id": proposal_id,
        "candidate_policy_version": candidate["version"],
        "current_policy_version": proposal.get(
            "current_policy_version"
        ),
        "approval_validation": validation,
        "message": (
            "Approval recorded. The policy is not active yet."
        ),
    }


