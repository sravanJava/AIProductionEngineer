# ---------------------------------------------------------
# INCIDENT INVESTIGATION
# ---------------------------------------------------------

@app.post("/investigate")
def investigate_incident_endpoint(
    request: InvestigateRequest,
):
    service = request.service.strip()
    problem = request.problem.strip()

    if not service or not problem:
        raise HTTPException(
            status_code=422,
            detail="Service and problem are required.",
        )

    try:
        previous_incidents = find_similar_resolved_incidents(
            service=service,
            problem=problem,
            limit=3,
        )

        # The current agent builds its own policy from
        # adaptive_policy.py. Active-policy integration into
        # the agent is a separate step.
        result = investigate_with_agent(
            service=service,
            problem=problem,
            previous_incidents=previous_incidents,
        )

        incident_document = {
            "service": service,
            "problem": problem,
            "ai_analysis": result.get("ai_analysis", ""),
            "diagnosis": result.get("diagnosis", {}),
            "memory_used": result.get("memory_used", []),
            "harness": result.get("harness", {}),
            "status": "open",
            "created_at": utc_now(),
            "updated_at": utc_now(),
        }

        insert_result = incidents.insert_one(incident_document)
        incident_document["_id"] = insert_result.inserted_id

        return {
            "incident": serialize_incident(incident_document),
            "ai_analysis": result.get("ai_analysis", ""),
            "diagnosis": result.get("diagnosis", {}),
            "memory_used": result.get("memory_used", []),
            "harness": result.get("harness", {}),
        }

    except HTTPException:
        raise

    except Exception:
        logger.exception("Incident investigation failed")

        raise HTTPException(
            status_code=500,
            detail="Incident investigation failed. Check backend logs.",
        )


# ---------------------------------------------------------
# LIST INCIDENTS
# ---------------------------------------------------------

@app.get("/incidents")
def list_incidents(
    limit: int = 50,
    status: str | None = None,
):
    limit = max(1, min(limit, 200))

    query = {}

    if status:
        allowed_statuses = {"open", "resolved"}

        if status not in allowed_statuses:
            raise HTTPException(
                status_code=400,
                detail="Status must be 'open' or 'resolved'.",
            )

        query["status"] = status

    documents = list(
        incidents.find(query)
        .sort("created_at", DESCENDING)
        .limit(limit)
    )

    return {
        "count": len(documents),
        "incidents": [
            serialize_incident(document)
            for document in documents
        ],
    }


