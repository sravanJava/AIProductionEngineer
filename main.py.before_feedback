class InvestigateRequest(BaseModel):
    service: str = Field(min_length=1, max_length=100)
    problem: str = Field(min_length=1, max_length=5000)


class ResolveIncidentRequest(BaseModel):
    root_cause: str = Field(min_length=1, max_length=5000)
    resolution: str = Field(min_length=1, max_length=5000)
    verification_notes: str = Field(
        default="",
        max_length=5000,
    )


class HarnessEvaluationRequest(BaseModel):
    sample_size: int = Field(ge=0, le=100000)
    memory_helpfulness_rate: float = Field(ge=0, le=1)


# ---------------------------------------------------------
# GENERAL HELPERS
# ---------------------------------------------------------

def utc_now():
    return datetime.now(timezone.utc)


def serialize_document(document: dict) -> dict:
    """Convert MongoDB ObjectId and datetime values to JSON-safe values."""
    result = {}

    for key, value in document.items():
        if key == "_id":
            result["id"] = str(value)
        elif isinstance(value, ObjectId):
            result[key] = str(value)
        elif isinstance(value, datetime):
            result[key] = value.isoformat()
        else:
            result[key] = value

    return result


def serialize_incident(document: dict) -> dict:
    result = serialize_document(document)

    if "id" in result:
        result["incident_id"] = result.pop("id")

    return result


def get_object_id(identifier: str) -> ObjectId:
    try:
        return ObjectId(identifier)
    except (InvalidId, TypeError):
        raise HTTPException(
            status_code=400,
            detail="Invalid ID format.",
        )


def find_similar_resolved_incidents(
    service: str,
    problem: str,
    limit: int = 3,
) -> list[dict]:
    """
    Find resolved incidents from the same service.

    This uses simple keyword overlap, not semantic vector search.
    Historical matches are clues, not proof of a root cause.
    """
    documents = list(
        incidents.find(
            {
                "service": service,
                "status": "resolved",
            }
        ).sort("resolved_at", DESCENDING).limit(100)
    )

    problem_words = {
        word.lower().strip(".,!?():;")
        for word in problem.split()
        if len(word) > 2
    }

    ranked = []

    for document in documents:
        historical_text = (
            str(document.get("problem", ""))
            + " "
            + str(document.get("root_cause", ""))
            + " "
            + str(document.get("resolution", ""))
        )

        historical_words = {
            word.lower().strip(".,!?():;")
            for word in historical_text.split()
            if len(word) > 2
        }

        overlap = len(problem_words & historical_words)

        if overlap > 0:
            ranked.append((overlap, document))

    ranked.sort(key=lambda item: item[0], reverse=True)

    return [
        serialize_incident(document)
        for _, document in ranked[:limit]
    ]


# ---------------------------------------------------------
# ACTIVE POLICY REGISTRY
# ---------------------------------------------------------

def get_or_create_active_policy() -> dict:
    """
    Read the active policy from MongoDB.

    If no active policy exists, initialize it from BASE_POLICY.
    """
    document = active_policies.find_one({"_id": "active"})

    if document:
        return document

    initial_policy = deepcopy(BASE_POLICY)
    validation = validate_policy(initial_policy)

    if not validation["valid"]:
        raise HTTPException(
            status_code=500,
            detail="Default policy failed safety validation.",
        )

    active_policies.update_one(
        {"_id": "active"},
        {
            "$setOnInsert": {
                "policy": initial_policy,
                "version": initial_policy["version"],
                "updated_at": utc_now(),
                "activated_from_proposal": None,
            }
        },
        upsert=True,
    )

    document = active_policies.find_one({"_id": "active"})

    if not document:
        raise HTTPException(
            status_code=500,
            detail="Could not initialize the active policy.",
        )

    return document


