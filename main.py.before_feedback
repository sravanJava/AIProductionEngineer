@app.post("/harness/evaluate")
def evaluate_harness(
    request: HarnessEvaluationRequest,
):
    metrics = {
        "sample_size": request.sample_size,
        "memory_helpfulness_rate": (
            request.memory_helpfulness_rate
        ),
    }

    proposal = propose_improvement(metrics)

    evaluation_document = {
        "metrics": metrics,
        "proposal_created": proposal.get(
            "proposal_created", False
        ),
        "proposal_result": proposal,
        "created_at": utc_now(),
    }

    evaluation_result = harness_evaluations.insert_one(
        evaluation_document
    )

    response = {
        "evaluation_id": str(evaluation_result.inserted_id),
        "proposal_created": proposal.get(
            "proposal_created", False
        ),
        "proposal_result": proposal,
    }

    if proposal.get("proposal_created"):
        proposal_document = {
            "status": "proposed",
            "rationale": proposal["rationale"],
            "sample_size": proposal["sample_size"],
            "metrics": proposal["metrics"],
            "current_policy_version": (
                proposal["current_policy_version"]
            ),
            "candidate_policy": proposal["candidate_policy"],
            "validation": proposal["validation"],
            "requires_human_approval": True,
            "automatically_activated": False,
            "created_at": utc_now(),
        }

        insert_result = harness_proposals.insert_one(
            proposal_document
        )

        response["proposal_id"] = str(
            insert_result.inserted_id
        )

    return response


