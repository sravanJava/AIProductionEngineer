# ---------------------------------------------------------
# HARNESS: ACTIVATE APPROVED POLICY
# ---------------------------------------------------------

@app.post("/harness/proposals/{proposal_id}/activate")
def activate_harness_proposal(proposal_id: str):
    object_id = get_object_id(proposal_id)

    try:
        active_document = get_or_create_active_policy()
    except HTTPException:
        raise
    except Exception:
        logger.exception("Could not initialize active policy")

        raise HTTPException(
            status_code=500,
            detail="Could not initialize the active policy.",
        )

    proposal = harness_proposals.find_one(
        {"_id": object_id}
    )

    if not proposal:
        raise HTTPException(
            status_code=404,
            detail="Harness proposal not found.",
        )

    if proposal.get("status") != "approved":
        raise HTTPException(
            status_code=409,
            detail="Only approved proposals can be activated.",
        )

    candidate = proposal.get("candidate_policy")

    if not isinstance(candidate, dict):
        raise HTTPException(
            status_code=400,
            detail="Candidate policy is missing or invalid.",
        )

    validation = validate_policy(candidate)

    if not validation["valid"]:
        raise HTTPException(
            status_code=400,
            detail={
                "message": "Candidate policy failed validation.",
                "errors": validation["errors"],
            },
        )

    current_version = active_document["version"]

    if proposal.get("current_policy_version") != current_version:
        raise HTTPException(
            status_code=409,
            detail=(
                "Proposal is based on a different policy version. "
                "Create and review a new proposal."
            ),
        )

    if candidate.get("version") != current_version + 1:
        raise HTTPException(
            status_code=409,
            detail="Candidate version must be the next version.",
        )

    now = utc_now()

    # Compare-and-set prevents overwriting a newer policy version.
    update_result = active_policies.update_one(
        {
            "_id": "active",
            "version": current_version,
        },
        {
            "$set": {
                "policy": candidate,
                "version": candidate["version"],
                "updated_at": now,
                "activated_from_proposal": proposal_id,
            }
        },
    )

    if update_result.modified_count != 1:
        raise HTTPException(
            status_code=409,
            detail=(
                "Active policy changed during activation. "
                "Reload the active policy before retrying."
            ),
        )

    proposal_update = harness_proposals.update_one(
        {
            "_id": object_id,
            "status": "approved",
        },
        {
            "$set": {
                "status": "activated",
                "activated_at": now,
            }
        },
    )

    if proposal_update.modified_count != 1:
        logger.error(
            "Policy updated, but proposal status update failed: %s",
            proposal_id,
        )

        raise HTTPException(
            status_code=409,
            detail=(
                "Policy may already be active, but proposal status "
                "was not updated. Check the active policy before "
                "retrying."
            ),
        )

    return {
        "status": "activated",
        "proposal_id": proposal_id,
        "active_version": candidate["version"],
        "message": (
            "Policy saved in the active registry. "
            "The investigation agent still needs to load this "
            "registry for the policy to affect investigations."
        ),
    }
